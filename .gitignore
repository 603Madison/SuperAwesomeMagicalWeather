/site/

# iOS: generated by XcodeGen from iosApp/project.yml, and Xcode's own state
iosApp/*.xcodeproj
iosApp/App/Info.plist
iosApp/App/App.entitlements
iosApp/Widget/Info.plist
iosApp/Widget/Widget.entitlements
xcuserdata/
DerivedData/

# Garmin watch app: build output and the developer signing key (never commit it)
garmin/bin/
garmin/*.der
garmin/*.pem
