<?xml version="1.0" encoding="utf-8"?>
<!-- SuperAwesomeMagicalWeather for Wear OS talks only to public HTTPS services, so cleartext is off everywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
